@page "/"

<PageTitle>Home</PageTitle>

<div class="max-w-2xl mx-auto text-center pt-12">
    <h1 class="text-4xl font-bold text-primary mb-4">LiveBPM Project</h1>
    <p class="text-lg text-base-content/70 mb-8">
        A Clean Architecture + CQRS + Blazor WASM scaffold ready to become anything.
    </p>
    <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="card-body">
            <h2 class="card-title">Vertical sample feature</h2>
            <p class="text-base-content/70">
                Visit the <a href="/todos" class="link link-primary">Todos</a> page to see a domain entity flow through
                MediatR handlers, an API controller, and a Blazor UI end to end.
            </p>
            <div class="card-actions justify-end mt-4">
                <a href="/todos" class="btn btn-primary">Open Todos</a>
            </div>
        </div>
    </div>
</div>
